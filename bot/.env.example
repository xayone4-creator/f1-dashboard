# Copie ce fichier en ".env" (dans le même dossier bot/) et remplis les valeurs.

# Onglet "Bot" du portail développeur Discord → Reset Token
DISCORD_TOKEN=

# Onglet "General Information" du portail développeur Discord → Application ID
DISCORD_CLIENT_ID=

# Optionnel mais recommandé en développement : l'ID de ton serveur Discord
# (clic droit sur le serveur → Copier l'ID, avec le mode développeur activé).
# Les commandes apparaissent instantanément sur CE serveur uniquement.
# Laisse vide pour un enregistrement global (jusqu'à 1h de propagation).
DISCORD_GUILD_ID=

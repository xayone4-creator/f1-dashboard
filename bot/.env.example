# Copie ce fichier en ".env" (dans le même dossier bot/) et remplis les valeurs.

# Onglet "Bot" du portail développeur Discord → Reset Token
DISCORD_TOKEN=

# Onglet "General Information" du portail développeur Discord → Application ID
DISCORD_CLIENT_ID=

# Optionnel mais recommandé en développement : l'ID de ton serveur Discord
# (clic droit sur le serveur → Copier l'ID, avec le mode développeur activé).
# Les commandes apparaissent instantanément sur CE serveur uniquement.
# Laisse vide pour un enregistrement global (jusqu'à 1h de propagation).
DISCORD_GUILD_ID=

# Secret partagé avec le dashboard local (variable BOT_INGEST_SECRET côté
# dashboard, dans le .env à la racine du projet) : doit être EXACTEMENT la
# même valeur des deux côtés. Génère une chaîne aléatoire longue, ex. :
# openssl rand -hex 32
# Sur Railway, configure-la comme variable d'environnement du service (pas
# besoin de fichier .env sur Railway, tout se fait dans l'onglet Variables).
INGEST_SECRET=

# Optionnel : chemin absolu vers un Volume Railway monté, pour que la base
# du bot (drivers/laps/lobbies/ligues) survive aux redéploiements. Sans ça,
# le bot repart de zéro à chaque déploiement. Exemple si le Volume est
# monté sur /data : DB_PATH=/data/apex.db
DB_PATH=

# Copie ce fichier en ".env" à la racine du projet (à côté de ce fichier)
# et remplis les valeurs pour que le dashboard local pousse chaque tour
# vers le bot Discord hébergé sur Railway.

# URL publique de ton service bot sur Railway (Settings → Networking →
# Public Networking → "Generate Domain" si ce n'est pas déjà fait).
# Exemple : https://apex-bot-production.up.railway.app
BOT_INGEST_URL=

# Doit être EXACTEMENT la même valeur que la variable INGEST_SECRET
# configurée sur le service Railway du bot. Génère une chaîne aléatoire
# longue (ex. openssl rand -hex 32) et mets-la des deux côtés.
BOT_INGEST_SECRET=

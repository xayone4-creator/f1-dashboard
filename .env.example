# Copie ce fichier en ".env" (à la racine du projet, à côté de server/) et
# remplis les valeurs. Uniquement nécessaire si le bot Discord tourne
# ailleurs que sur ton PC (ex. Railway) et doit recevoir tes tours à distance.

# URL publique du bot Discord sur Railway (ex. https://mon-bot.up.railway.app)
BOT_INGEST_URL=

# Doit être IDENTIQUE à INGEST_SECRET dans bot/.env — c'est ce qui protège
# le point d'entrée du bot contre des envois non autorisés. Choisis une
# chaîne aléatoire longue (ex. générée avec un gestionnaire de mots de passe).
INGEST_SECRET=
